{
  "expo": {
    "name": "FitLife",
    "slug": "fitlife",
    "version": "1.0.0",
    "scheme": "fitlife",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elaapp.fitlife",
      "infoPlist": {
        "NSCameraUsageDescription": "FitLife nutzt die Kamera, um Barcodes von Lebensmitteln zu scannen.",
        "NSMotionUsageDescription": "FitLife liest deine Schritte aus, um dein tägliches Schrittziel anzuzeigen.",
        "NSSupportsLiveActivities": true,
        "NSPhotoLibraryUsageDescription": "FitLife nutzt deine Fotos für Fortschrittsfotos und die Kalorienschätzung per Foto."
      }
    },
    "android": {
      "package": "com.elaapp.fitlife",
      "adaptiveIcon": {
        "backgroundColor": "#16a34a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_WEIGHT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitLife nutzt deine Fotos für Fortschrittsfotos und die Kalorienschätzung per Foto.",
          "cameraPermission": "FitLife nutzt die Kamera für Barcodes, Essensfotos und Fortschrittsfotos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FitLife nutzt die Kamera, um Barcodes von Lebensmitteln zu scannen.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#15803d"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "FitLife liest deine Schritte aus, um dein tägliches Schrittziel anzuzeigen."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "FitWidget",
              "displayName": "FitLife",
              "description": "Schritte, Kalorien, Wasser, Eiweiß oder Challenges auf einen Blick",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/FitWidget.ios.tsx",
                "configuration": {
                  "title": "Anzeige wählen",
                  "description": "Was soll dieses Widget zeigen?",
                  "parameters": {
                    "metric": {
                      "title": "Anzeige",
                      "type": "enum",
                      "default": "app",
                      "values": [
                        {
                          "name": "Wie in der App",
                          "value": "app"
                        },
                        {
                          "name": "Übersicht",
                          "value": "overview"
                        },
                        {
                          "name": "Schritte",
                          "value": "steps"
                        },
                        {
                          "name": "Kalorien",
                          "value": "kcal"
                        },
                        {
                          "name": "Wasser",
                          "value": "water"
                        },
                        {
                          "name": "Eiweiß",
                          "value": "protein"
                        },
                        {
                          "name": "Challenges",
                          "value": "challenge"
                        }
                      ]
                    }
                  }
                }
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "initialLayout": "./src/widgets/FitWidget.android.tsx"
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FitLife liest Schritte, Schlaf und Gewicht aus Apple Health, um deine Tagesziele anzuzeigen.",
          "NSHealthUpdateUsageDescription": "FitLife speichert deine Trainings und dein Gewicht in Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
